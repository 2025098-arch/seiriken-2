modules = ["nodejs-20"]
[agent]
expertMode = true

[userenv]

[userenv.shared]

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "cloudrun"

[deployment.run]
args = ["sh", "-c", "/nix/store/1lagpgadaybvs1n2312gysg2phjk89y8-nodejs-20.20.0-wrapped/bin/node $file"]

[deployment.run.env]
file = "index.js"
